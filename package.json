{
	"name": "mortgage-calculator",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "yarn@4.18.1",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite --host",
		"build": "tsc -b && vite build",
		"start": "yarn build && serve -c serve.json -l ${PORT:-3000}",
		"typecheck": "tsc -b --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"format": "biome format --write . && prettier --write \"**/*.{md,yml,yaml}\"",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"postinstall": "husky"
	},
	"dependencies": {
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-router": "8.5.1",
		"serve": "14.2.6"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/dom": "10.4.2",
		"@testing-library/react": "16.3.3",
		"@types/node": "22.20.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"husky": "9.1.7",
		"jsdom": "30.1.3",
		"lint-staged": "17.6.0",
		"prettier": "3.9.10",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	},
	"resolutions": {
		"compression": "1.8.2"
	}
}
