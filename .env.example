# Optional. The app runs without a .env file: both values below are the built-in defaults.
# The app makes no network calls today, so VITE_API_BASE_URL is unused.
# NOTE: every VITE_* variable is inlined into the public client bundle.
# They are PUBLIC. Never put secrets, tokens or private keys in them.
# VITE_API_BASE_URL=/api
# VITE_APP_NAME=Mortgage Calculator
