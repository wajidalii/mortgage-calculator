{
	"$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"ignoreUnknown": false,
		"includes": ["**", "!**/dist", "!**/node_modules", "!**/.yarn"]
	},
	"formatter": { "enabled": true, "indentStyle": "tab" },
	"javascript": { "formatter": { "quoteStyle": "double" } },
	"css": { "parser": { "tailwindDirectives": true } },
	"assist": {
		"enabled": true,
		"actions": { "source": { "organizeImports": "on" } }
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"complexity": { "useArrowFunction": "error" },
			"style": {
				"useImportType": "error",
				"noDefaultExport": "off"
			},
			"suspicious": { "noExplicitAny": "error" }
		}
	},
	"overrides": [
		{
			"includes": ["src/**/*.tsx"],
			"plugins": [
				"./biome-plugins/component-arrow-function.grit",
				"./biome-plugins/component-default-export.grit"
			],
			"linter": {
				"rules": { "style": { "useComponentExportOnlyModules": "error" } }
			}
		}
	]
}
